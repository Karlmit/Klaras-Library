# Copy to .env and edit. Every variable is read by the container at startup.

# ---- required ----------------------------------------------------------------

# Password for the bundled Postgres container.
POSTGRES_PASSWORD=change-me

# Absolute path on the host to your ebook library. Mounted at /library.
LIBRARY_ROOT=/mnt/user/books

# The public HTTPS URL this server is reached at. Kobo devices are handed
# absolute download URLs, so this must be what the DEVICE can resolve, not the
# container address. Must be https -- Kobo silently fails on http downloads.
KLARAS_EXTERNAL_URL=https://library.example.com

# ---- optional ----------------------------------------------------------------

POSTGRES_USER=klaras
POSTGRES_DB=klaras

# Host port for the web UI. Defaults to 8084 because the existing
# calibre-web instance already occupies 8083.
KLARAS_PORT=8084

# Where Postgres data and the cover/KEPUB cache live.
DATA_DIR=./data

# Drop ebook files here for automatic ingest.
INGEST_DIR=./ingest

# debug | info | warn | error
KLARAS_LOG_LEVEL=info

# Forward requests Klaras does not implement to the real Kobo store, so the
# device's shop still works. Off keeps the device from talking to Kobo at all.
KLARAS_KOBO_PROXY_STORE=false

# Managed tree layout. Placeholders: {author_sort} {series} {series_index}
# {title} {year} {id}
KLARAS_PATH_TEMPLATE_SERIES={author_sort}/{series}/{series_index} - {title}
KLARAS_PATH_TEMPLATE_PLAIN={author_sort}/{title}
KLARAS_FILE_TEMPLATE={title} - {author_sort}
